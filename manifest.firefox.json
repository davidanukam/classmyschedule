{
  "manifest_version": 3,
  "name": "ClassMyCalendar",
  "description": "Export DraftMySchedule classes to .ics, Google Calendar, or Outlook.",
  "version": "2.0.0",
  "icons": {
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "96": "assets/icon96.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "ClassMyCalendar"
  },
  "permissions": ["tabs", "storage", "identity", "scripting", "downloads"],
  "host_permissions": [
    "https://draftmyschedule.uwo.ca/*",
    "https://www.westerncalendar.uwo.ca/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://draftmyschedule.uwo.ca/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{ca8e7d4b-5156-408e-8b9d-c48d44d1078c}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  }
}
